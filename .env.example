# Copy to .env and fill in. The real .env is gitignored — never commit secrets.

# --- HubSpot (EU region uses a pat-eu1 token but the same api.hubapi.com host) ---
HUBSPOT_ACCESS_TOKEN=pat-xxxx-your-private-app-token
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_BASE_URL=https://api.hubapi.com

# --- Anthropic (agent execution) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Reasoning model for forecasting / accountability agents:
FORECAST_MODEL=claude-opus-4-8
# Cheap model for labeling / summaries:
CLAUDE_SOURCING_MODEL=claude-haiku-4-5

# --- App ---
PIPELINE_ID=default
PORT=8787
QUARTER_START=2026-04-01
TIMEZONE=America/New_York
